# Salin ke .env.campus atau .env.cloud — jangan commit file berisi secret asli

# --- DATABASE ---
# Kampus: postgresql://user:pass@127.0.0.1:5432/dbname
# Cloud:  postgresql://...@ep-xxx.neon.tech/kost?sslmode=require
DATABASE_URL=

JWT_SECRET=change-me
JWT_EXPIRES_DAYS=7
JWT_REMEMBER_EXPIRES_DAYS=30

WHATSAPP_VERIFY_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KostSolo <you@example.com>

# URL publik backend (untuk link foto /files/...)
API_PUBLIC_URL=http://localhost:8080
# URL publik FRONTEND (dipakai untuk link absolut di email,
# mis. reset password). Tanpa trailing slash.
# Contoh produksi: https://atapsolo.netlify.app
# Lokal dev: http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
PORT=8080

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

WA_PROVIDER=FONNTE
FONNTE_TOKEN=

LEAD_PAYMENT_BANK_NAME=
LEAD_PAYMENT_ACCOUNT_NUMBER=
LEAD_PAYMENT_ACCOUNT_HOLDER=
LEAD_PAYMENT_AMOUNT=50000
LEAD_PAYMENT_NOTES=
