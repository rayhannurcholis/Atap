{
  "name": "kostsolo-backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.js",
    "start:campus": "bun --env-file=.env.campus src/index.js",
    "start:cloud": "bun --env-file=.env.cloud src/index.js",
    "dev": "bun --watch src/index.js",
    "dev:campus": "bun --env-file=.env.campus --watch src/index.js",
    "dev:cloud": "bun --env-file=.env.cloud --watch src/index.js",
    "prisma:migrate:campus": "bun --env-file=.env.campus prisma migrate deploy",
    "prisma:migrate:cloud": "bun --env-file=.env.cloud prisma migrate deploy",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:generate": "bunx prisma generate",
    "postinstall": "prisma generate",
    "prisma:studio": "bunx prisma studio",
    "cleanup:stuck": "bun scripts/cleanup-stuck-user.js",
    "cleanup:stuck:cloud": "bun --env-file=.env.cloud scripts/cleanup-stuck-user.js",
    "cleanup:stuck:campus": "bun --env-file=.env.campus scripts/cleanup-stuck-user.js"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@hono/swagger-ui": "^0.6.0",
    "@hono/zod-openapi": "^1.2.2",
    "@prisma/client": "6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "hono": "^4.12.4",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "nodemailer": "^8.0.2",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  }
}
